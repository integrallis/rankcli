{
  "name": "vite-plugin-rankcli",
  "version": "0.0.1",
  "description": "Vite plugin for SEO validation, sitemap generation, and meta tag injection - RankCLI",
  "license": "MIT",
  "homepage": "https://rankcli.dev",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "seo",
    "sitemap",
    "meta-tags",
    "rankcli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rankcli/rankcli"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "lint": "eslint src --ext ts"
  },
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
