{
  "name": "next-rankcli",
  "version": "0.0.1",
  "description": "Next.js plugin for SEO automation - metadata generation, sitemap, robots.txt - RankCLI",
  "license": "MIT",
  "homepage": "https://rankcli.dev",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./metadata": {
      "import": "./dist/metadata.js",
      "types": "./dist/metadata.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "next",
    "nextjs",
    "seo",
    "metadata",
    "sitemap",
    "rankcli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rankcli/rankcli"
  },
  "scripts": {
    "build": "tsup src/index.ts src/metadata.ts --format esm --dts",
    "dev": "tsup src/index.ts src/metadata.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "next": "^13.0.0 || ^14.0.0 || ^15.0.0 || ^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
