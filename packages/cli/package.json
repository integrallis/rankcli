{
  "name": "@rankcli/cli",
  "version": "0.0.51",
  "description": "RankCLI - Ship code, get ranked. SEO meets CI/CD.",
  "homepage": "https://rankcli.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/integrallis/rankcli.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/integrallis/rankcli/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "rankcli": "./bin/rankcli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:js",
    "build:js": "npm run update-version && tsup src/index.ts --format cjs,esm --dts",
    "inject-config": "node scripts/inject-config.js",
    "build:sea": "bash scripts/build-sea.sh",
    "prepublishOnly": "npm run build && npm run inject-config",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "update-version": "node scripts/update-version.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rankcli/agent-runtime": "workspace:*",
    "@supabase/supabase-js": "^2.98.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "conf": "^12.0.0",
    "ora": "5.4.1",
    "inquirer": "^9.2.0",
    "axios": "^1.6.0",
    "cheerio": "1.0.0-rc.12",
    "open": "^10.0.0",
    "table": "^6.8.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "seo",
    "cli",
    "automation",
    "developer-tools"
  ],
  "author": "Brian Sam-Bodden",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
