{
  "name": "@seo-autopilot/github-action",
  "version": "0.1.0",
  "description": "GitHub Action for SEO Autopilot - 200+ automated SEO checks with auto-fix PRs",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "package": "pnpm run build"
  },
  "keywords": [
    "github-action",
    "seo",
    "audit",
    "automation",
    "ci-cd"
  ],
  "author": "SEO Autopilot",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@seo-autopilot/agent-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vercel/ncc": "^0.38.1",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
